{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/git-identity-guard.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/enforce-rg.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/enforce-fd.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/auto-format.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/doc-drift-reminder.sh"
          }
        ]
      }
    ]
  }
}
